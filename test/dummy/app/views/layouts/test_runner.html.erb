<!DOCTYPE html>
<html>
<head>
  <title>Fenetre JavaScript tests</title>
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <%= javascript_include_tag "qunit" %>
  <script>
    QUnit.config.autostart = false;
    QUnit.config.testTimeout = 10000;
    window.qunitFailures = [];
    QUnit.log(result => {
      if (!result.result) window.qunitFailures.push({message: result.message, source: result.source});
    });
    QUnit.done(result => {
      window.qunitResult = result;
      document.body.dataset.qunitComplete = "true";
    });
  </script>
  <%= javascript_importmap_tags "test/test_runner" %>
</head>
<body>
  <div id="qunit"></div>
  <div id="qunit-fixture"></div>
</body>
</html>
